# TrustVault Security Configuration
ENVIRONMENT=development
APP_NAME=TrustVault
TAGLINE="Secure Document Sharing. Verifiable Trust."

# Cryptographic Keys (Change in production! Must be 32+ bytes)
SECRET_KEY=trustvault_super_secret_jwt_master_key_32_bytes_min!
MASTER_ENCRYPTION_KEY=trustvault_aes_256_gcm_master_storage_key_32b!
AUDIT_HMAC_KEY=trustvault_audit_hmac_integrity_chain_key_2026!

# Session Management
SINGLE_ACTIVE_SESSION=true
SESSION_EXPIRE_MINUTES=120

# Storage & Upload Limits
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
STORAGE_DIR=storage/encrypted_vault
DATABASE_URL=sqlite:///trustvault.db

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
